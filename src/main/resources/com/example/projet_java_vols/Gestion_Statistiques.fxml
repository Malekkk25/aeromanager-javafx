<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projet_java_vols.Gestion_des_vols.Controller.GestionStatsController"
            prefWidth="1200" prefHeight="700"
            style="-fx-background-color: #f0f8ff;">


    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="0"
                  style="-fx-background-color: white; -fx-padding: 12 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">


                <HBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Button text="🏢 Aéroports" onAction="#allerAeroports"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"/>

                    <Button text="✈ Vols" onAction="#allerVols"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"/>

                    <Button text="🛬 Escales" onAction="#allerEscales"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"/>

                    <Button text="🎫 Réservations" onAction="#allerReservations"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"/>

                    <Button text="👥 Employés"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>


                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="🔔"
                            style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-size: 16px; -fx-padding: 8 12; -fx-background-radius: 50%; -fx-cursor: hand;"/>

                    <Button text="⚙️"
                            style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-size: 16px; -fx-padding: 8 12; -fx-background-radius: 50%; -fx-cursor: hand;"/>

                    <Separator orientation="VERTICAL" style="-fx-background-color: #e5e7eb;">
                        <HBox.margin>
                            <Insets left="5" right="5"/>
                        </HBox.margin>
                    </Separator>

                    <HBox alignment="CENTER" spacing="8"
                          style="-fx-background-color: #eff6ff; -fx-padding: 6 12; -fx-background-radius: 20;">
                        <Label text="👤" style="-fx-font-size: 14px;"/>
                        <Label text="Admin"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    </HBox>
                </HBox>
            </HBox>


            <HBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: linear-gradient(to right, #1e3a8a, #2563eb); -fx-padding: 8 14;">
                <Label text="📈" style="-fx-text-fill: white; -fx-font-size: 20px;"/>
                <Label text="Dashboard Statistiques des Vols"
                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="•" style="-fx-text-fill: #93c5fd; -fx-font-size: 14px;"/>
                <Label text="Vue globale des vols, taux d’occupation et revenus"
                       style="-fx-text-fill: #bfdbfe; -fx-font-size: 11px;"/>
            </HBox>
        </VBox>
    </top>


    <center>
        <VBox spacing="8" style="-fx-padding: 8;">


            <HBox spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 1);">
                    <Label text="✈" style="-fx-font-size: 26px; -fx-text-fill: #2563eb;"/>
                    <VBox spacing="2">
                        <Label text="Vols du jour" style="-fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                        <Label fx:id="lblVolsJour" text="0"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1d4ed8;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 1);">
                    <Label text="🪑" style="-fx-font-size: 26px; -fx-text-fill: #16a34a;"/>
                    <VBox spacing="2">
                        <Label text="Taux d’occupation moyen" style="-fx-font-weight: bold; -fx-text-fill: #065f46;"/>
                        <Label fx:id="lblTauxOccupation" text="0 %"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 1);">
                    <Label text="💶" style="-fx-font-size: 26px; -fx-text-fill: #7c3aed;"/>
                    <VBox spacing="2">
                        <Label text="Revenus du jour" style="-fx-font-weight: bold; -fx-text-fill: #4c1d95;"/>
                        <Label fx:id="lblRevenusJour" text="0.00 €"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
                    </VBox>
                </HBox>
            </HBox>


            <HBox spacing="8" VBox.vgrow="ALWAYS">
                <VBox spacing="4" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 1);">
                    <Label text="Vols par destination (aujourd’hui)"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                    <BarChart fx:id="barVolsDestination" VBox.vgrow="ALWAYS">
                        <xAxis>
                            <CategoryAxis label="Destination"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Nombre de vols"/>
                        </yAxis>
                    </BarChart>
                </VBox>

                <VBox spacing="4" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 1);">
                    <Label text="Répartition vols National / International"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                    <PieChart fx:id="pieTypeVol" VBox.vgrow="ALWAYS"/>
                </VBox>
            </HBox>


            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Label fx:id="lblDerniereMaj"
                       text="Dernière mise à jour: -"
                       style="-fx-font-size: 10px; -fx-text-fill: #6b7280;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄 Rafraîchir maintenant"
                        onAction="#relancerRefresh"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 5 12; -fx-background-radius: 7;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
