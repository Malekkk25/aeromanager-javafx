<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projet_java_vols.Gestion_des_utilisateurs.Controller.LoginController"
            prefWidth="800"
            prefHeight="650"
            style="-fx-background-color: #f0f8ff;">


    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #1e3a8a, #2563eb); -fx-padding: 30;">
            <HBox alignment="CENTER" spacing="15">
                <Label text="✈ " style="-fx-text-fill: white; -fx-font-size: 48px;"/>
                <Label text="Système de Gestion de Vols"
                       style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
            </HBox>
            <Label text="Connexion à votre espace"
                   style="-fx-text-fill: #bfdbfe; -fx-font-size: 14px;"
                   alignment="CENTER">
                <VBox.margin>
                    <Insets top="5"/>
                </VBox.margin>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 25;">

            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 30;">

                <VBox alignment="CENTER" spacing="5">
                    <Label text="Bienvenue !"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                    <Label text="Veuillez vous connecter pour continuer"
                           style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                </VBox>

                <Separator style="-fx-background-color: #2563eb;"/>

                <VBox spacing="10">
                    <Label text="👤 Nom d'utilisateur"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af; -fx-font-size: 14px;"/>
                    <TextField fx:id="txtUsername"
                               promptText="Entrez votre nom d'utilisateur"
                               style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 14px;"/>
                </VBox>

                <VBox spacing="10">
                    <Label text="🔒 Mot de passe"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af; -fx-font-size: 14px;"/>
                    <PasswordField fx:id="txtPassword"
                                   promptText="Entrez votre mot de passe"
                                   style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 14px;"/>
                </VBox>



                <HBox fx:id="errorBox"
                      visible="false"
                      managed="false"
                      alignment="CENTER"
                      spacing="10"
                      style="-fx-background-color: #fee2e2; -fx-border-color: #dc2626; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;">
                    <Label text="⚠️" style="-fx-font-size: 18px;"/>
                    <Label fx:id="lblError"
                           text="Nom d'utilisateur ou mot de passe incorrect"
                           style="-fx-text-fill: #dc2626; -fx-font-size: 13px; -fx-font-weight: bold;"
                           wrapText="true"
                           HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="btnLogin"
                            text="🔐 Se Connecter"
                            onAction="#handleLogin"
                            defaultButton="true"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 40; -fx-background-radius: 8; -fx-cursor: hand;"/>



                </HBox>
            </VBox>


        </VBox>
    </center>

    <bottom>

    </bottom>

    <StackPane fx:id="loadingOverlay"
               visible="false"
               managed="false"
               style="-fx-background-color: rgba(255, 255, 255, 0.95);">
        <VBox alignment="CENTER" spacing="15">
            <ProgressIndicator style="-fx-progress-color: #2563eb;"/>
            <Label text="Connexion en cours..."
                   style="-fx-font-size: 15px; -fx-text-fill: #1e3a8a; -fx-font-weight: bold;"/>
        </VBox>
    </StackPane>

</BorderPane>