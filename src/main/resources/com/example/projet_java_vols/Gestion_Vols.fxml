<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projet_java_vols.Gestion_des_vols.Controller.GestionVolsController"
            prefWidth="1200"
            prefHeight="700"
            style="-fx-background-color: #f0f8ff;">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="0"
                  style="-fx-background-color: white; -fx-padding: 12 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">


                <HBox alignment="CENTER" spacing="8" style="-fx-padding: 0 15 0 0;">
                    <Label text="✈ " style="-fx-font-size: 24px;"/>
                    <Label text="AeroManager"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                </HBox>

                <Separator orientation="VERTICAL" style="-fx-background-color: #e5e7eb;">
                    <HBox.margin>
                        <Insets left="10" right="15"/>
                    </HBox.margin>
                </Separator>


                <HBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Button fx:id="btnMenuEmployes" text="👥 Employés"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"
                            onAction="#allerEmploye"
                    />
                    <Button fx:id="btnMenuAeroports" text="🏢 Aéroports" onAction="#allerAeroports"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"/>

                    <Button fx:id="btnMenuVols" text="✈ Vols" onAction="#allerVols"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;"
                            />

                    <Button  fx:id="btnMenuEscales" text="🛬 Escales" onAction="#allerEscales"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"/>

                    <Button fx:id="btnMenuReservations" text="🎫 Réservations" onAction="#allerReservations"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"/>


                </HBox>


                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="🔔"
                            style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-size: 16px; -fx-padding: 8 12; -fx-background-radius: 50%; -fx-cursor: hand;"/>

                    <Button text="⚙️ "
                            style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-size: 16px; -fx-padding: 8 12; -fx-background-radius: 50%; -fx-cursor: hand;"/>

                    <Separator orientation="VERTICAL" style="-fx-background-color: #e5e7eb;">
                        <HBox.margin>
                            <Insets left="5" right="5"/>
                        </HBox.margin>
                    </Separator>

                    <HBox alignment="CENTER" spacing="8"
                          style="-fx-background-color: #eff6ff; -fx-padding: 6 12; -fx-background-radius: 20;">
                        <Label text="👤" style="-fx-font-size: 14px;"/>
                        <Label text="Admin"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    </HBox>
                </HBox>
            </HBox>


            <HBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: linear-gradient(to right, #1e3a8a, #2563eb); -fx-padding: 8 14;">
                <Label text="✈" style="-fx-text-fill: white; -fx-font-size: 20px;"/>
                <Label text="Gestion des Vols"
                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="•" style="-fx-text-fill: #93c5fd; -fx-font-size: 14px;"/>
                <Label text="Système de gestion des vols internationaux et nationaux"
                       style="-fx-text-fill: #bfdbfe; -fx-font-size: 11px;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox fx:id="vboxFormulaire" spacing="8" style="-fx-padding: 8;">

            <VBox spacing="6" fx:id="containerSaisie"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.09), 10, 0, 0, 1); -fx-padding: 10;">
                <Label text="📝 Informations du Vol"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                <Separator style="-fx-background-color: #2563eb;"/>

                <GridPane hgap="18" vgap="5" maxWidth="Infinity">

                    <Label text="Type de Vol:" style="-fx-font-weight: bold; -fx-text-fill: #1e40af;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <HBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <RadioButton fx:id="rbInternational" text="International" selected="true"
                                     style="-fx-text-fill: #1e40af; -fx-font-weight: bold;" onAction="#onTypeVolChanged"/>
                        <RadioButton fx:id="rbNational" text="National"
                                     style="-fx-text-fill: #1e40af; -fx-font-weight: bold;" onAction="#onTypeVolChanged"/>
                    </HBox>
                    <Label text="Départ:" style="-fx-font-weight: bold; -fx-text-fill: #1e40af;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <HBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <ComboBox fx:id="cmbAeroportDepart" promptText="Sélectionnez départ"
                                  style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6;"/>
                        <DatePicker fx:id="dpDateDepart" promptText="JJ/MM/AAAA"
                                    style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6;"/>
                        <TextField fx:id="txtHeureDepart" promptText="HH:MM"
                                   style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6;"/>
                    </HBox>




                    <Label text="Arrivée:" style="-fx-font-weight: bold; -fx-text-fill: #1e40af;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <HBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="5">
                        <ComboBox fx:id="cmbAeroportArrivee" promptText="Sélectionnez arrivée"
                                  style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6;"/>
                        <DatePicker fx:id="dpDateArrivee" promptText="JJ/MM/AAAA"
                                    style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6;"/>
                        <TextField fx:id="txtHeureArrivee" promptText="HH:MM"
                                   style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6;"/>
                        <Button text="🤖 Suggérer"
                                onAction="#suggérerHoraire"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 4 8; -fx-background-radius: 6;"/>

                    </HBox>
                    <Label text="N° Vol:" style="-fx-font-weight: bold; -fx-text-fill: #1e40af;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtNumVol" promptText="Ex: AF123"
                               style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <HBox spacing="65" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Pays Destination:" style="-fx-font-weight: bold; -fx-text-fill: #1e40af;" />

                    <Label text="Statut:" style="-fx-font-weight: bold; -fx-text-fill: #1e40af;" />

                    </HBox><HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="3">

                    <TextField fx:id="txtPaysDestination" promptText="Pays d'arrivée "
                               style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6;"
                               />
                    <ComboBox fx:id="cmbStatut" promptText="Statut du vol"
                              style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6;" />
                </HBox>

                    <Label text="Prix de Base:" style="-fx-font-weight: bold; -fx-text-fill: #1e40af;" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    <TextField fx:id="txtPrixBase" promptText="Prix en €"
                               style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6;"
                               GridPane.columnIndex="1" GridPane.rowIndex="5"
                               onKeyReleased="#calculerPrixTotal"/>
                    <Label text="Places Dispo:" style="-fx-font-weight: bold; -fx-text-fill: #1e40af;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <Spinner fx:id="spinPlaces" min="1" max="500" initialValue="150" editable="true"
                             style="-fx-background-color: #eff6ff;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <Label fx:id="lblChampSpecifique1" text="N° Autorisation Inter.:" style="-fx-font-weight: bold; -fx-text-fill: #1e40af;" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtChampSpecifique1" promptText="Numéro d'autorisation "
                               style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6;" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                    <Label fx:id="lblChampSpecifique2" text="Exigence Visa:" style="-fx-font-weight: bold; -fx-text-fill: #1e40af;" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                    <CheckBox fx:id="chkExigenceVisa" text="Visa requis"
                              style="-fx-text-fill: #1e40af;" GridPane.columnIndex="2" GridPane.rowIndex="5" onAction="#calculerPrixTotal"/>
                    <Label fx:id="lblTerminal" text="Terminal Domestique:" style="-fx-font-weight: bold; -fx-text-fill: #1e40af;" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                    <TextField fx:id="txtTerminal" promptText="Nom du terminal domestique"
                               style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6;"
                               GridPane.columnIndex="2" GridPane.rowIndex="5"/>

                    <columnConstraints>
                        <ColumnConstraints percentWidth="33"/>
                        <ColumnConstraints percentWidth="33"/>
                        <ColumnConstraints percentWidth="33"/>
                    </columnConstraints>
                </GridPane>



                <HBox alignment="CENTER" spacing="15"
                      style="-fx-background-color: #f0fdf4; -fx-padding: 8; -fx-background-radius: 7; -fx-border-color: #10b981; -fx-border-width: 2; -fx-border-radius: 7;">
                    <VBox alignment="CENTER" spacing="2">
                        <Label text="💰 Prix Total (avec taxes)"
                               style="-fx-font-weight: bold; -fx-text-fill: #065f46; -fx-font-size: 12px;"/>
                        <Label fx:id="lblPrixTotal"
                               text="0.00 €"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                    </VBox>
                    <Separator orientation="VERTICAL"/>
                    <VBox alignment="CENTER" spacing="2">
                        <Label text="📊 Détails"
                               style="-fx-font-weight: bold; -fx-text-fill: #065f46; -fx-font-size: 11px;"/>
                        <Label fx:id="lblDetailsPrix"
                               text="Base: 0€ | Taxes: 0€"
                               style="-fx-font-size: 10px; -fx-text-fill: #047857;"/>
                    </VBox>
                </HBox>


                <HBox spacing="8" alignment="CENTER">
                    <Button fx:id="btnAjouter"
                            text="➕ Ajouter Vol"
                            onAction="#ajouterVol"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 14; -fx-background-radius: 7;"/>
                    <Button fx:id="btnAnnuler"
                            text="❌ Annuler"
                            onAction="#annulerAction"
                            style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 14; -fx-background-radius: 7;"/>
                </HBox>
            </VBox>


            <VBox spacing="6"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08),10,0,0,2); -fx-padding: 8;"
                  VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="📋 Liste des Vols"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblNombreVols"
                           text="Total: 0"
                           style="-fx-font-size: 11px; -fx-text-fill: #2563eb; -fx-font-weight: bold; -fx-background-color: #dbeafe; -fx-padding: 3 8; -fx-background-radius: 15;"/>
                </HBox>
                <Separator style="-fx-background-color: #2563eb;"/>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="🔍" style="-fx-font-size: 14px;"/>
                    <TextField fx:id="txtRecherche"
                               promptText="Rechercher vol..."
                               style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 6; -fx-font-size: 11px;"
                               HBox.hgrow="ALWAYS"/>
                </HBox>
                <TableView fx:id="tableVols"
                           style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6;"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNumVol" text="N° Vol" prefWidth="80"
                                     style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                        <TableColumn fx:id="colType" text="Type" prefWidth="90"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colDepart" text="Départ" prefWidth="120"/>
                        <TableColumn fx:id="colArrivee" text="Arrivée" prefWidth="120"/>
                        <TableColumn fx:id="colDateDepart" text="Date Départ" prefWidth="90"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colHeureDepart" text="Heure" prefWidth="70"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colPlaces" text="Places" prefWidth="60"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colPrix" text="Prix Total" prefWidth="90"
                                     style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="100"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colNumAutorisation" text="N° Autorisation" prefWidth="120" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colVisa" text="Frais Visa" prefWidth="90" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colTerminal" text="Terminal" prefWidth="100" style="-fx-alignment: CENTER;"/>




                    </columns>
                    <placeholder>
                        <VBox spacing="1" alignment="CENTER">
                            <Label text="✈" style="-fx-font-size: 38px; -fx-text-fill: #93c5fd;"/>
                            <Label text="Aucun vol enregistré"
                                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10"
              style="-fx-background-color: linear-gradient(to right, #1e3a8a, #2563eb); -fx-padding: 7;">
            <Button fx:id="btnSupprimer"
                    text="🗑️ Supprimer"
                    onAction="#supprimerVol"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 16; -fx-background-radius: 8;"/>
            <Button fx:id="btnModifier"
                    text="✏️ Modifier"
                    onAction="#modifierVol"
                    style="-fx-background-color: #1e40af; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 16; -fx-background-radius: 8;"/>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </bottom>
</BorderPane>