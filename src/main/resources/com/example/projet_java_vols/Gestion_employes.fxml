<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projet_java_vols.Gestion_des_utilisateurs.Controller.GestionEmployesController"
            prefWidth="1200" prefHeight="700"
            style="-fx-background-color: #f0f8ff;">


    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="0"
                  style="-fx-background-color: white; -fx-padding: 12 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">


                <HBox alignment="CENTER" spacing="8" style="-fx-padding: 0 15 0 0;">
                    <Label text="✈ " style="-fx-font-size: 24px;"/>
                    <Label text="AeroManager"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                </HBox>

                <Separator orientation="VERTICAL" style="-fx-background-color: #e5e7eb;">
                    <HBox.margin>
                        <Insets left="10" right="15"/>
                    </HBox.margin>
                </Separator>


                <HBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Button text="👥 Employés"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;"/>

                    <Button text="🏢 Aéroports" onAction="#allerAeroports"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"/>

                    <Button text="✈ Vols" onAction="#allerVols"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"/>

                    <Button text="🛬 Escales" onAction="#allerEscales"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"/>

                    <Button text="🎫 Réservations" onAction="#allerReservations"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"/>


                </HBox>


                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="🔔"
                            style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-size: 16px; -fx-padding: 8 12; -fx-background-radius: 50%; -fx-cursor: hand;"/>
                    <Button text="⚙️"
                            style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-size: 16px; -fx-padding: 8 12; -fx-background-radius: 50%; -fx-cursor: hand;"/>

                    <Separator orientation="VERTICAL" style="-fx-background-color: #e5e7eb;">
                        <HBox.margin>
                            <Insets left="5" right="5"/>
                        </HBox.margin>
                    </Separator>

                    <HBox alignment="CENTER" spacing="8"
                          style="-fx-background-color: #eff6ff; -fx-padding: 6 12; -fx-background-radius: 20;">
                        <Label text="👤" style="-fx-font-size: 14px;"/>
                        <Label text="Admin"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    </HBox>
                </HBox>
            </HBox>


            <HBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: linear-gradient(to right, #1e3a8a, #2563eb); -fx-padding: 8 14;">
                <Label text="👥" style="-fx-text-fill: white; -fx-font-size: 20px;"/>
                <Label text="Gestion des Employés"
                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="•" style="-fx-text-fill: #93c5fd;"/>
                <Label fx:id="lblAdminInfo"
                       text="Administrateur: -"
                       style="-fx-text-fill: #bfdbfe; -fx-font-size: 11px;"/>
            </HBox>
        </VBox>
    </top>


    <center>
        <VBox spacing="8" style="-fx-padding: 8;">


            <VBox spacing="10"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.09), 10,0,0,1); -fx-padding: 10;">
                <Label text="📝 Informations de l'employé"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                <Separator style="-fx-background-color: #2563eb;"/>

                <GridPane hgap="12" vgap="10"
                          style="-fx-background-color: #f8fafc; -fx-background-radius: 10;">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140" prefWidth="150"/>
                        <ColumnConstraints minWidth="180" hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="140" prefWidth="150"/>
                        <ColumnConstraints minWidth="180" hgrow="ALWAYS"/>
                    </columnConstraints>


                    <Label text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <ComboBox fx:id="cmbTypeEmploye"
                              promptText="Agent de Vol / Agent d'Enregistrement"
                              GridPane.columnIndex="1" GridPane.rowIndex="0"
                              style="-fx-background-color: #eff6ff; -fx-border-color: #2563eb;"/>

                    <Label text="Nom:" GridPane.columnIndex="2" GridPane.rowIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <TextField fx:id="txtNom" GridPane.columnIndex="3" GridPane.rowIndex="0"
                               promptText="Nom"
                               style="-fx-background-color: #eff6ff; -fx-border-color: #2563eb;"/>


                    <Label text="Prénom:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <TextField fx:id="txtPrenom" GridPane.columnIndex="1" GridPane.rowIndex="1"
                               promptText="Prénom"
                               style="-fx-background-color: #eff6ff; -fx-border-color: #2563eb;"/>

                    <Label text="Email:" GridPane.columnIndex="2" GridPane.rowIndex="1"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <TextField fx:id="txtEmail" GridPane.columnIndex="3" GridPane.rowIndex="1"
                               promptText="email@example.com"
                               style="-fx-background-color: #eff6ff; -fx-border-color: #2563eb;"/>


                    <Label text="Téléphone:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <TextField fx:id="txtTelephone" GridPane.columnIndex="1" GridPane.rowIndex="2"
                               promptText="0612345678"
                               style="-fx-background-color: #eff6ff; -fx-border-color: #2563eb;"/>

                    <Label text="Mot de passe:" GridPane.columnIndex="2" GridPane.rowIndex="2"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <PasswordField fx:id="txtMotDePasse" GridPane.columnIndex="3" GridPane.rowIndex="2"
                                   promptText="Mot de passe"
                                   style="-fx-background-color: #eff6ff; -fx-border-color: #2563eb;"/>


                    <Label text="Statut:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <ComboBox fx:id="cmbStatut"
                              promptText="Actif / Inactif"
                              GridPane.columnIndex="1" GridPane.rowIndex="3"
                              style="-fx-background-color: #eff6ff; -fx-border-color: #2563eb;"/>

                </GridPane>


                <VBox fx:id="vboxAgentVol" spacing="8"
                      style="-fx-background-color: #E8EAF6; -fx-padding: 10; -fx-background-radius: 8;"
                      managed="false" visible="false">

                    <Label text="Agent de Vol"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>

                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="140" prefWidth="150"/>
                            <ColumnConstraints minWidth="180" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="140" prefWidth="150"/>
                            <ColumnConstraints minWidth="180" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Code compagnie:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtCodeCompagnie" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Nom compagnie:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtNomCompagnie" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                        <Label text="Pays d'origine:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtPaysOrigine" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Flotte:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <TextField fx:id="txtFlotte" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    </GridPane>
                </VBox>


                <VBox fx:id="vboxAgentEnreg" spacing="8"
                      style="-fx-background-color: #E8EAF6; -fx-padding: 10; -fx-background-radius: 8;"
                      managed="false" visible="false">

                    <Label text="Agent d'Enregistrement"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>

                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="140" prefWidth="150"/>
                            <ColumnConstraints minWidth="180" hgrow="ALWAYS"/>
                            <ColumnConstraints minWidth="140" prefWidth="150"/>
                            <ColumnConstraints minWidth="180" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Bureau:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtBureau" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Comptoir:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtComptoir" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                    </GridPane>
                </VBox>


                <HBox spacing="8" alignment="CENTER">
                    <Button text="➕ Ajouter"
                            onAction="#ajouterEmploye"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 14; -fx-background-radius: 7;"/>
                    <Button text="❌ Annuler"
                            onAction="#effacerFormulaire"
                            style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 14; -fx-background-radius: 7;"/>
                </HBox>

            </VBox>


            <VBox spacing="6" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08),10,0,0,2); -fx-padding: 8;">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="📋 Liste des employés"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <Separator/>

                <TableView fx:id="tableEmployes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdEmploye" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="60"/>
                        <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="60"/>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="80"/>
                        <TableColumn fx:id="colTelephone" text="Téléphone" prefWidth="120"/>
                        <TableColumn fx:id="colType" text="Type" prefWidth="140"/>
                        <TableColumn fx:id="colActif" text="Actif" prefWidth="60"/>
                        <TableColumn fx:id="colCodeCompagnie" text="Code Cie" prefWidth="80"/>
                        <TableColumn fx:id="colNomCompagnie" text="Nom Cie" prefWidth="120"/>
                        <TableColumn fx:id="colPaysOrigine" text="Pays" prefWidth="100"/>
                        <TableColumn fx:id="colFlotte" text="Flotte" prefWidth="70"/>
                        <TableColumn fx:id="colBureau" text="Bureau" prefWidth="120"/>
                        <TableColumn fx:id="colComptoir" text="Comptoir" prefWidth="80"/>
                    </columns>
                </TableView>





            </VBox>

        </VBox>
    </center>


    <bottom>
        <HBox alignment="CENTER" spacing="10"
              style="-fx-background-color: linear-gradient(to right, #1e3a8a, #2563eb); -fx-padding: 7;">
            <Button fx:id="btnSupprimer"
                    text="🗑️ Supprimer"
                    onAction="#supprimerEmployeSelection"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 16; -fx-background-radius: 8;"/>

            <Button fx:id="btnModifier"
                    text="✏️ Modifier"
                    onAction="#modifierEmployeSelection"
                    style="-fx-background-color: #1e40af; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 16; -fx-background-radius: 8;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Quitter"
                    onAction="#quitter"
                    style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 16; -fx-background-radius: 8;"/>
        </HBox>
    </bottom>

</BorderPane>
