<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.projet_java_vols.Gestion_des_vols.Controller.GestionEscalesController"
            prefWidth="1200"
            prefHeight="700"
            style="-fx-background-color: #f0f8ff;">

    <top>
        <VBox>

            <HBox alignment="CENTER_LEFT" spacing="0"
                  style="-fx-background-color: white; -fx-padding: 12 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">


                <HBox alignment="CENTER" spacing="8" style="-fx-padding: 0 15 0 0;">
                    <Label text="✈ " style="-fx-font-size: 24px;"/>
                    <Label text="AeroManager"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                </HBox>

                <Separator orientation="VERTICAL" style="-fx-background-color: #e5e7eb;">
                    <HBox.margin>
                        <Insets left="10" right="15"/>
                    </HBox.margin>
                </Separator>


                <HBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Button  fx:id="btnMenuEmployes" text="👥 Employés"
                            onAction="#allerEmploye"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;" />
                    <Button fx:id="btnMenuAeroports" text="🏢 Aéroports" onAction="#allerAeroports"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"/>

                    <Button  fx:id="btnMenuVols" text="✈ Vols" onAction="#allerVols"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"/>

                    <Button fx:id="btnMenuEscales" text="🛬 Escales" onAction="#allerEscales"

                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;"
                           />

                    <Button fx:id="btnMenuReservations" text="🎫 Réservations" onAction="#allerReservations"
                            style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: transparent; -fx-cursor: hand;"
                            onMouseEntered="#handleMouseEntered" onMouseExited="#handleMouseExited"/>


                </HBox>


                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="🔔"
                            style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-size: 16px; -fx-padding: 8 12; -fx-background-radius: 50%; -fx-cursor: hand;"/>

                    <Button text="⚙️ "
                            style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-size: 16px; -fx-padding: 8 12; -fx-background-radius: 50%; -fx-cursor: hand;"/>

                    <Separator orientation="VERTICAL" style="-fx-background-color: #e5e7eb;">
                        <HBox.margin>
                            <Insets left="5" right="5"/>
                        </HBox.margin>
                    </Separator>

                    <HBox alignment="CENTER" spacing="8"
                          style="-fx-background-color: #eff6ff; -fx-padding: 6 12; -fx-background-radius: 20;">
                        <Label text="👤" style="-fx-font-size: 14px;"/>
                        <Label text="Admin"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    </HBox>
                </HBox>
            </HBox>


            <HBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: linear-gradient(to right, #1e3a8a, #2563eb); -fx-padding: 8 14;">
                <Label text="🛬" style="-fx-text-fill: white; -fx-font-size: 20px;"/>
                <Label text="Gestion des Escales"
                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="•" style="-fx-text-fill: #93c5fd; -fx-font-size: 14px;"/>
                <Label text="Gestion des arrêts intermédiaires des vols"
                       style="-fx-text-fill: #bfdbfe; -fx-font-size: 11px;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox fx:id="vboxFormulaire" spacing="8" style="-fx-padding: 8;">

            <VBox fx:id="containerSaisie" spacing="6"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.09), 10, 0, 0, 1); -fx-padding: 10;">
                <Label text="📝 Informations de l'Escale"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                <Separator style="-fx-background-color: #2563eb;"/>

                <GridPane hgap="16" vgap="12"
                          style="-fx-background-color: #f8fafc; -fx-background-radius: 13;">

                    <Label text="N° Vol:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <ComboBox fx:id="cmbVol" promptText="Sélectionnez le vol"
                              style="-fx-background-color: #eff6ff; -fx-border-color: #2563eb; -fx-border-radius: 7; -fx-background-radius: 7;"
                              GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"/>
                    <Label text="Ordre:" GridPane.columnIndex="2" GridPane.rowIndex="0"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <Spinner fx:id="spinOrdre" min="1" max="10" initialValue="1" editable="true"
                             style="-fx-background-color: #eff6ff; -fx-border-color: #2563eb; -fx-border-radius: 7; -fx-background-radius: 7;"
                             GridPane.columnIndex="3" GridPane.rowIndex="0"/>


                    <Label text="Départ:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <ComboBox fx:id="cmbAeroportDepart" promptText="Aéroport départ"
                              style="-fx-background-color: #eff6ff; -fx-border-color: #2563eb; -fx-border-radius: 7; -fx-background-radius: 7;"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Arrivée:" GridPane.columnIndex="2" GridPane.rowIndex="1"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <ComboBox fx:id="cmbAeroportArrivee" promptText="Aéroport arrivée"
                              style="-fx-background-color: #eff6ff; -fx-border-color: #2563eb; -fx-border-radius: 7; -fx-background-radius: 7;"
                              GridPane.columnIndex="3" GridPane.rowIndex="1"/>


                    <Label text="Date Départ:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <DatePicker fx:id="dpDateDepart" promptText="JJ/MM/AAAA"
                                style="-fx-background-color: #eff6ff; -fx-border-color: #2563eb; -fx-border-radius: 7; -fx-background-radius: 7;"
                                GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Date Arrivée:" GridPane.columnIndex="2" GridPane.rowIndex="2"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <DatePicker fx:id="dpDateArrivee" promptText="JJ/MM/AAAA"
                                style="-fx-background-color: #eff6ff; -fx-border-color: #2563eb; -fx-border-radius: 7; -fx-background-radius: 7;"
                                GridPane.columnIndex="3" GridPane.rowIndex="2"/>


                    <Label text="Heure Départ:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <TextField fx:id="txtHeureDepart" promptText="HH:MM"
                               style="-fx-background-color: #eff6ff; -fx-border-color: #2563eb; -fx-border-radius: 7; -fx-background-radius: 7;"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Label text="Heure Arrivée:" GridPane.columnIndex="2" GridPane.rowIndex="3"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e40af;"/>
                    <TextField fx:id="txtHeureArrivee" promptText="HH:MM"
                               style="-fx-background-color: #eff6ff; -fx-border-color: #2563eb; -fx-border-radius: 7; -fx-background-radius: 7;"
                               GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                    <columnConstraints>
                        <ColumnConstraints minWidth="80" prefWidth="120"/>
                        <ColumnConstraints minWidth="140" prefWidth="150"/>
                        <ColumnConstraints minWidth="80" prefWidth="120"/>
                        <ColumnConstraints minWidth="140" prefWidth="150"/>
                    </columnConstraints>
                </GridPane>





                <HBox alignment="CENTER" spacing="8"
                      style="-fx-background-color: #d1fae5; -fx-padding: 6; -fx-background-radius: 7; -fx-border-color: #3b82f6; -fx-border-width: 1; -fx-border-radius: 7;">
                    <Label text="⏱️" style="-fx-font-size: 16px;"/>
                    <Label text="Durée calculée:"
                           style="-fx-font-weight: bold; -fx-text-fill: #1e3a8a; -fx-font-size: 12px;"/>
                    <Label fx:id="lblDuree"
                           text="-- min"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                </HBox>


                <HBox spacing="8" alignment="CENTER">
                    <Button fx:id="btnAjouter"
                            text="➕ Ajouter"
                            onAction="#ajouterEscale"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 14; -fx-background-radius: 7;"/>
                    <Button fx:id="btnAnnuler"
                            text="❌ Annuler"
                            onAction="#annulerAction"
                            style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 14; -fx-background-radius: 7;"/>
                </HBox>
            </VBox>


            <VBox spacing="6"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08),10,0,0,2); -fx-padding: 8;"
                  VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="📋 Liste des Escales"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblNombreEscales"
                           text="Total: 0"
                           style="-fx-font-size: 11px; -fx-text-fill: #2563eb; -fx-font-weight: bold; -fx-background-color: #dbeafe; -fx-padding: 3 8; -fx-background-radius: 15;"/>
                </HBox>
                <Separator style="-fx-background-color: #2563eb;"/>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="🔍" style="-fx-font-size: 14px;"/>
                    <TextField fx:id="txtRecherche"
                               promptText="Rechercher escale..."
                               style="-fx-background-color: #eff6ff; -fx-border-color: #3b82f6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 6; -fx-font-size: 11px;"
                               HBox.hgrow="ALWAYS"/>
                </HBox>
                <TableView fx:id="tableEscales"
                           style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6;"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="60" />
                        <TableColumn fx:id="colNumVol" text="N° Vol" prefWidth="100" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                        <TableColumn fx:id="colOrdre" text="Ordre" prefWidth="70" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>

                        <TableColumn fx:id="colAeroportDepart" text="Aéroport Départ" prefWidth="150" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                        <TableColumn fx:id="colAeroportArrivee" text="Aéroport Arrivée" prefWidth="150" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                        <TableColumn fx:id="colDateDepart" text="Date Départ" prefWidth="100" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                        <TableColumn fx:id="colHeureDepart" text="Heure Départ" prefWidth="90" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                        <TableColumn fx:id="colDateArrivee" text="Date Arrivée" prefWidth="100" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                        <TableColumn fx:id="colHeureArrivee" text="Heure Arrivée" prefWidth="90" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>

                    </columns>
                    <placeholder>
                        <VBox spacing="1" alignment="CENTER">
                            <Label text="🛬" style="-fx-font-size: 38px; -fx-text-fill: #93c5fd;"/>
                            <Label text="Aucune escale enregistrée"
                                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10"
              style="-fx-background-color: linear-gradient(to right, #1e3a8a, #2563eb); -fx-padding: 7;">
            <Button fx:id="btnSupprimer"
                    text="🗑️ Supprimer"
                    onAction="#supprimerEscale"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 16; -fx-background-radius: 8;"/>
            <Button fx:id="btnModifier"
                    text="✏️ Modifier"
                    onAction="#modifierEscale"
                    style="-fx-background-color: #1e40af; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 16; -fx-background-radius: 8;"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </bottom>
</BorderPane>